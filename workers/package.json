{
  "name": "gowa-cloudflare-workers",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "prepare:native": "bun scripts/prepare-native.ts",
    "dev": "bun run prepare:native && wrangler dev --var DEVELOPMENT:true",
    "typecheck": "tsc --noEmit",
    "test": "bun test test/unit.test.ts",
    "test:integration": "bun scripts/smoke.ts",
    "build": "bun run prepare:native && wrangler deploy --dry-run --outdir dist",
    "deploy": "bun run prepare:native && wrangler deploy",
    "secrets:generate": "bun scripts/secrets.ts"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "0.10.4",
    "@modelcontextprotocol/sdk": "1.30.1",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "pino": "9.14.0",
    "qrcode-generator": "2.0.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260923.1",
    "@types/node": "22.20.4",
    "typescript": "5.9.3",
    "wrangler": "4.137.0"
  },
  "overrides": {
    "whatsapp-rust-bridge": "0.5.4"
  }
}
