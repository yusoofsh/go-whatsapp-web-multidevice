# Copy to an untracked .env file. Never commit real credentials.
APP_BASIC_AUTH=admin:replace-with-a-long-random-password
GOWA_PUBLIC_URL=https://wa.example.com
GOWA_PORT=3001
GOWA_IMAGE_TAG=mcp
# Optional deterministic dashboard pin. Set both values from an audited gowa-ui release.
APP_UI_RELEASE_TAG=
APP_UI_ASSET_SHA256=
APP_UI_AUTO_UPDATE=true
TZ=Asia/Jakarta
